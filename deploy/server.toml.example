# nuvia-server configuration.
# Caddy terminates TLS on 443 and proxies HTTP to http_bind.

http_bind = "127.0.0.1:4646"
udp_bind = "0.0.0.0:8443"
public_url = "https://relay.example.com"

# A peer is considered offline after this many seconds without register/hello.
peer_ttl_secs = 60
# Empty rooms are kept for this long so a late invitee can still join.
room_ttl_secs = 86400
# Maximum participants allowed in any room. Clients may request a lower
# per-room limit; the GUI keeps its rooms at 8, while the CLI can use up to 32.
max_peers_per_room = 32
max_rooms = 1024
