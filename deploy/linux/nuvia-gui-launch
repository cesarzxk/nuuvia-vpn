#!/bin/sh
# Starts the GUI. When the privileged nuvia-helper service is running, the GUI
# stays unprivileged and talks to it over loopback. Otherwise fall back to the
# original pkexec launch so a missing helper does not break anyone.
if [ "$(id -u)" -eq 0 ]; then
    exec /usr/bin/nuvia-gui "$@"
fi

if systemctl is-active --quiet nuvia-helper 2>/dev/null; then
    exec /usr/bin/nuvia-gui "$@"
fi

if command -v pkexec >/dev/null 2>&1; then
    if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        exec pkexec env \
            DISPLAY="${DISPLAY:-:0}" \
            XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" \
            XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
            DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" \
            /usr/bin/nuvia-gui "$@"
    fi
    exec pkexec env \
        DISPLAY="${DISPLAY:-:0}" \
        XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
        /usr/bin/nuvia-gui "$@"
fi

exec /usr/bin/nuvia-gui "$@"
